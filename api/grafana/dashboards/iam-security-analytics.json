  "panels": [
    {
      "title": "High Risk Events",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(iam_high_risk_events_total[5m])) by (event_type)",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Risk Score Distribution",
      "type": "heatmap",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(iam_risk_score_distribution_bucket[5m])) by (le)",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ]
    },
    {
      "title": "RBAC Denials by Permission",
      "type": "table",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, sum(increase(iam_rbac_denied_total[1h])) by (role, permission, route))",
          "legendFormat": "{{role}} — {{permission}} — {{route}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "title": "Authentication Failures by Reason",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(increase(iam_auth_failures_total[1h])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "title": "JWT Verification Failures",
      "type": "timeseries",
      "datasource": "Prometheus",
