        {
          "expr": "sum(rate(iam_jwt_verification_failures_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        },
        {
          "expr": "rate(jwt_tamper_detected_total[5m])",
          "legendFormat": "Tamper Detected",
          "refId": "B"
        }
      ]
