# .env.example
# Local Development Configuration Template
# DO NOT ADD REAL SECRETS TO THIS FILE

# Application Configuration
NODE_ENV=development
PORT=3000
WORKER_METRICS_PORT=9091
DEFENSE_WORKER_METRICS_PORT=9092
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# Secrets (Used strictly by local EnvProvider)
# In Docker, these are provided by /run/secrets and SECRET_PROVIDER=docker-secrets
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authdb
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret
INTERNAL_SERVICE_TOKEN=dev_internal_token_32_bytes_random_hex
ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACTIVE_KEY_VERSION=1

# JWT Keys (Either point to valid PEM strings or manage via Docker secrets)
JWT_PRIVATE_KEY=your-private-key-pem-content
JWT_PUBLIC_KEY=your-public-key-pem-content

# KID-based Dynamic JWT Rotation Keys
JWT_KEY_KEY1_PRIVATE=your-kid1-private-key
JWT_KEY_KEY1_PUBLIC=your-kid1-public-key
